# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Database -------------------------------------------------------------
# Local development uses the bundled PostgreSQL started by `npm run db:start`
# (no Docker needed). In production, point this at a managed PostgreSQL.
DATABASE_URL="postgresql://shop:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5433/leathershop?schema=public"
# Direct connection for migrations. Same as DATABASE_URL locally; on Neon use the non-pooled URL.
DATABASE_URL_UNPOOLED="postgresql://shop:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5433/leathershop?schema=public"
# Password for the bundled local PostgreSQL (must match DATABASE_URL above).
LOCAL_DB_PASSWORD="CHANGE_ME_LOCAL_DB_PASSWORD"
LOCAL_DB_PORT=5433

# --- App ------------------------------------------------------------------
# Public base URL of the app. Used in Telegram messages and for origin checks.
# Local: http://localhost:3000   Production: https://your-domain.example
APP_URL="http://localhost:3000"

# Extra origins allowed to call admin APIs (comma separated), e.g. a tunnel URL.
ALLOWED_ORIGINS=""

# --- Telegram (server side only, never exposed to the browser) ------------
# Bot token from @BotFather. Leave empty to disable Telegram features.
TELEGRAM_BOT_TOKEN=""
# Chat or group ID that receives new-order notifications (group IDs start with -100).
TELEGRAM_ADMIN_CHAT_ID=""

# --- Payment providers (not integrated yet) --------------------------------
# Telebirr and Chapa are NOT implemented. Orders use manual confirmation.
# These placeholders reserve names for a future integration.
CHAPA_SECRET_KEY=""
TELEBIRR_APP_ID=""
TELEBIRR_APP_KEY=""
